# Copy to .env and fill in values. Never commit .env.

# Database
# --- Local dev (recommended): run `npm run db:local:up` then use this URL ---
# Keeps one process / few connections; no Hostinger hourly connection cap.
# DATABASE_URL="mysql://root:sembuzz@127.0.0.1:3307/sembuzz?connection_limit=5"
#
# --- Remote Hostinger (production / shared dev DB) ---
# Add ?connection_limit=3 to reduce connection churn. Use `npm run start:stable` locally
# (not start:dev) so the server stays up instead of reconnecting on every file save.
DATABASE_URL="mysql://u500831783_Sembuzzz:YOUR_DB_PASSWORD@HOST:3306/u500831783_Sembuzzz?connection_limit=3"

# Server
PORT=3000
NODE_ENV=production

# JWT (use a long random string in production)
JWT_SECRET="your-secret-key-change-in-production"

# CORS: comma-separated allowed origins (frontend + www)
CORS_ORIGIN="https://sembuzz.com,https://www.sembuzz.com"

# Base URL of this API (for emails and links)
API_URL="https://api.sembuzz.com"

# Frontend URL (for email links)
FRONTEND_URL="https://sembuzz.com"

# SMTP (Hostinger) — required for registration OTP, password reset, and admin emails
# SMTP_FROM must be a real mailbox on your verified domain (same as SMTP_USER or an alias).
# Wrong sender (e.g. unverified domain) causes "Sender address rejected" and password reset will fail.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@sembuzz.com
SMTP_PASS=your-smtp-password
SMTP_FROM=admin@sembuzz.com

# Firebase Cloud Messaging — add the same keys to your real **.env** (not committed)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional
# SUPPORT_EMAIL=support@sembuzz.com

# Google OAuth (for meetings and "Add to Google Calendar" for users)
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=https://api.sembuzz.com/google/callback
# GOOGLE_CALENDAR_ADD_REDIRECT_URI=https://api.sembuzz.com/google/calendar/add-callback
# Optional: for local dev, use a separate OAuth client and set these (backend uses them when request is to localhost):
# GOOGLE_OAUTH_CLIENT_ID_LOCAL=...
# GOOGLE_OAUTH_CLIENT_SECRET_LOCAL=...

# OpenAI (banner analysis + Super Admin → Fetch Events / university extractor)
# OPENAI_API_KEY=sk-...
# OPENAI_UNIVERSITY_EXTRACT_MODEL=gpt-4.1-mini

# University Event Aggregator (optional tuning)
# UNIVERSITY_SYNC_INTERVAL_HOURS=6
# UNIVERSITY_SYNC_DISABLED=1
# Sync stores only events in the **current calendar month** in UNIVERSITY_EVENTS_TIMEZONE; older in-month rows are archived on each successful sync.
# UNIVERSITY_EVENT_HORIZON_DAYS is unused (legacy).
# IANA zone for month boundaries + public date filters (default America/New_York = US Eastern EST/EDT).
# UNIVERSITY_EVENTS_TIMEZONE=America/New_York
# Parser-first GPT path when at least N DOM/JSON-LD candidates found (else condensed listing extract).
# UNIVERSITY_PARSER_FIRST_MIN=4
# Parallel same-origin page fetches per crawl wave (default 4).
# UNIVERSITY_CRAWL_FETCH_PARALLEL=4
# After CSV upload, enqueue background sync job automatically (set 0 to disable).
# UNIVERSITY_SYNC_AUTO_QUEUE=1
# Background job worker (set 1 to disable queue processor).
# UNIVERSITY_SYNC_JOBS_DISABLED=0
# UNIVERSITY_SYNC_JOB_TICK_MS=1500
# Parallel sources processed inside one queued job (default 2).
# UNIVERSITY_JOB_SOURCE_PARALLEL=2

# Scraped event aggregation (new module: /super-admin/event-sync/*)
# Optional override for list/month/upcoming queries; defaults to UNIVERSITY_EVENTS_TIMEZONE.
# EVENT_SYNC_TIMEZONE=America/New_York

# JS calendars with "Load more" / infinite scroll (requires: npx playwright install chromium)
# UNIVERSITY_PLAYWRIGHT=1
# UNIVERSITY_PLAYWRIGHT_TIMEOUT_MS=28000
# UNIVERSITY_PLAYWRIGHT_SCROLL_ROUNDS=3
