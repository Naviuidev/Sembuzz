// ============================================
// PUBLIC USER (Student / Parent - website login)
// ============================================

model User {
  id                  String    @id @default(uuid())
  platformUserId      String    @unique
  name                String    // full name (firstName + lastName) for display
  firstName           String?
  lastName            String?
  profilePicUrl       String?   // optional profile picture URL
  email               String
  password            String    // hashed
  schoolId            String
  registrationMethod  String?   // 'school_domain' | 'gmail'
  status              String    @default("active") // 'pending_otp' | 'pending_approval' | 'active' | 'rejected'
  verificationDocUrl       String?   // for gmail: uploaded school doc (ID card, fee receipt, etc.)
  additionalVerificationDocUrl String?   // optional second doc when admin asks for "one more"
  otp                 String?   // one-time password for school domain verification
  otpExpiresAt        DateTime? @db.DateTime(3)
  approvalEmailVerifiedAt DateTime? @db.DateTime(3) // set when user clicks verify link after admin approval (gmail flow)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  platformUser   PlatformUser      @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  eventLikes     EventLike[]
  eventComments  EventComment[]
  savedEvents    UserSavedEvent[]
  helpQueries    UserHelpQuery[]
  pushDevices               UserPushDevice[]
  notificationSubCategories UserNotificationSubCategory[]
  notificationInbox         UserNotificationInbox[]
  clubGroupMessages         ClubGroupMessage[]
  clubGroupMemberships      ClubGroupMembership[]
  studentChatGroupsCreated  StudentChatGroup[] @relation("StudentChatGroupCreatedBy")
  studentChatGroupMembers   StudentChatGroupMember[]
  studentChatGroupMessages  StudentChatGroupMessage[]
  directConversationsAsOne  DirectConversation[] @relation("DirectConversationUserOne")
  directConversationsAsTwo  DirectConversation[] @relation("DirectConversationUserTwo")
  directConversationsRequested DirectConversation[] @relation("DirectConversationRequestedBy")
  directConversationsBlocked DirectConversation[] @relation("DirectConversationBlockedBy")
  directMessagesSent        DirectMessage[]
  passwordResetOtps         UserPasswordResetOtp[]

  @@index([schoolId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model UserPasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otp       String   @db.VarChar(6)
  expiresAt DateTime @db.DateTime(3)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otp, isUsed])
  @@map("user_password_reset_otps")
}

model UserHelpQuery {
