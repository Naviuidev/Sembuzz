  @@index([schoolId, lastMessageAt])
  @@index([schoolId, status])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([blockedByUserId])
  @@map("direct_conversations")
}

model DirectMessage {
  id               String   @id @default(uuid())
  conversationId   String
  senderUserId     String
  body             String   @default("") @db.Text
