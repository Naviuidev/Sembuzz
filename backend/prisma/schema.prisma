  @@index([sourceId])
  @@index([slug])
  @@index([startDate])
  @@map("scraped_event_records")
}

model ScrapedSyncLog {
  id          String    @id @default(uuid())
  sourceId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("running") @db.VarChar(32)
  totalEvents Int       @default(0)
  errors      String?   @db.Text
  /// Structured QA/debug: date ranges, months, samples, fetch mode, etc.
  detailsJson Json?

  source ScrapedEventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([startedAt])
  @@map("scraped_sync_logs")
}

model SchoolSocialAccount {
