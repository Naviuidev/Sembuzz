  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_direct_messaging_settings")
}

model DirectConversation {
  id                String    @id @default(uuid())
  schoolId          String
  userOneId         String
  userTwoId         String
  status            String    @default("pending") // pending | accepted | declined
  requestedByUserId String
  respondedAt       DateTime?
  lastMessageAt     DateTime?
  userOneLastReadAt DateTime?
  userTwoLastReadAt DateTime?
  blockedByUserId   String?
  blockedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userOne     User            @relation("DirectConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo     User            @relation("DirectConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("DirectConversationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  blockedBy   User?           @relation("DirectConversationBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)
