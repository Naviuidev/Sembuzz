  schoolName    String?
  schoolLogoUrl String?
  title         String
  body          String
  deliveredAt   DateTime  @default(now())
  readAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliveredAt])
  @@index([userId, readAt])
