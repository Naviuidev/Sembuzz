  replyToMessageId String?
  createdAt        DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo      DirectMessage?     @relation("DirectMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      DirectMessage[]    @relation("DirectMessageReplies")

  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("direct_messages")
}

model StudentChatGroup {
  id                          String    @id @default(uuid())
  schoolId                    String
  name                        String    @db.VarChar(120)
  description                 String?   @db.Text
  avatarUrl                   String?   @db.VarChar(1000)
  visibility                  String    @default("public") // public | private
  createdByUserId             String?
  createdBySubCategoryAdminId String?
  lastMessageAt               DateTime?
  isActive                    Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  school                    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy                 User?             @relation("StudentChatGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdBySubCategoryAdmin SubCategoryAdmin? @relation("StudentChatGroupCreatedBySubCategoryAdmin", fields: [createdBySubCategoryAdminId], references: [id], onDelete: SetNull)
  members                   StudentChatGroupMember[]
  messages                  StudentChatGroupMessage[]
  chatRequests              StudentChatGroupRequest[]
  deleteRequests            StudentChatGroupDeleteRequest[]

  @@index([schoolId, visibility, isActive])
  @@index([schoolId, lastMessageAt])
  @@map("student_chat_groups")
}

model StudentChatGroupMember {
  id         String    @id @default(uuid())
  groupId    String
  userId     String
  schoolId   String
  role       String    @default("member") // owner | admin | member
  status     String    @default("active") // active | left | banned
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  group  StudentChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([schoolId, status])
  @@index([groupId])
  @@map("student_chat_group_members")
}

model StudentChatGroupMessage {
  id               String   @id @default(uuid())
  groupId          String
  senderUserId     String
  body             String   @default("") @db.Text
  attachmentUrl    String?  @db.VarChar(1000)
  attachmentType   String?  // image | pdf
  attachmentName   String?  @db.VarChar(500)
  replyToMessageId String?
  createdAt        DateTime @default(now())

  group    StudentChatGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender   User                      @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo  StudentChatGroupMessage?  @relation("StudentChatGroupMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies  StudentChatGroupMessage[] @relation("StudentChatGroupMessageReplies")

  @@index([groupId, createdAt])
  @@index([replyToMessageId])
  @@map("student_chat_group_messages")
}

model StudentChatGroupRequest {
  id                 String    @id @default(uuid())
  schoolId           String
  subCategoryAdminId String
  name               String    @db.VarChar(120)
  description        String?   @db.Text
  visibility         String    @default("public") // public | private
  status             String    @default("pending") // pending | approved | declined
  reviewedByRole     String?   // category_admin | school_admin
  reviewedByAdminId  String?
  declineReason      String?   @db.Text
  studentChatGroupId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviewedAt         DateTime?

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subCategoryAdmin SubCategoryAdmin @relation(fields: [subCategoryAdminId], references: [id], onDelete: Cascade)
  studentChatGroup StudentChatGroup? @relation(fields: [studentChatGroupId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([subCategoryAdminId, createdAt])
  @@map("student_chat_group_requests")
}

model StudentChatGroupDeleteRequest {
  id                 String    @id @default(uuid())
  schoolId           String
  subCategoryAdminId String
  studentChatGroupId String
  note               String?   @db.Text
  status             String    @default("pending") // pending | approved | declined
  reviewedByRole     String?   // category_admin | school_admin
  reviewedByAdminId  String?
  declineReason      String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviewedAt         DateTime?

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subCategoryAdmin SubCategoryAdmin @relation(fields: [subCategoryAdminId], references: [id], onDelete: Cascade)
  studentChatGroup StudentChatGroup @relation(fields: [studentChatGroupId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt], map: "scg_del_req_school_status_created_idx")
  @@index([subCategoryAdminId, createdAt], map: "scg_del_req_subcat_created_idx")
  @@index([studentChatGroupId, status], map: "scg_del_req_group_status_idx")
  @@map("student_chat_group_delete_requests")
}

model AdminEmailChangeRequest {
  id                 String    @id @default(uuid())
  schoolId           String
  targetRole         String // category_admin | subcategory_admin | ads_admin
  targetAdminId      String
  targetName         String
  targetEmail        String
  initiatedByRole    String // school_admin | category_admin
  initiatedByAdminId String
  initiatedByName    String
  reason             String    @db.Text
  status             String    @default("pending_otp") // pending_otp | pending | pending_new_email_otp | approved | declined
  reviewerRole       String    @default("school_admin")
  otp                String?   @db.VarChar(6)
  otpExpiresAt       DateTime?
  otpUsed            Boolean   @default(false)
  proposedNewEmail   String?
  newEmailOtp        String?   @db.VarChar(6)
  newEmailOtpExpiresAt DateTime?
  newEmailOtpUsed    Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  declineReason      String?   @db.Text

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([targetRole, targetAdminId])
  @@map("admin_email_change_requests")
}
