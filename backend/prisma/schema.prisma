model ScrapedEventRecord {
  id            String    @id @default(uuid())
  sourceId      String
  title         String    @db.VarChar(500)
  slug          String    @db.VarChar(320)
  description   String?   @db.Text
  image         String?   @db.VarChar(2048)
  startDate     DateTime?
  endDate       DateTime?
  /// Local YYYY-MM-DD strings for recurring instances in the sync month (tooltip).
  occurrenceDatesJson Json?
  venue         String?   @db.VarChar(500)
  city          String?   @db.VarChar(200)
  country       String?   @db.VarChar(200)
  sourceUrl     String?   @db.VarChar(2048)
  sourceWebsite String?   @db.VarChar(2048)
  category      String?   @db.VarChar(120)
  organizer     String?   @db.VarChar(500)
  tags          String?   @db.Text
  dedupeKey     String    @db.VarChar(64)
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  source ScrapedEventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

